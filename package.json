{
  "name": "neon-slither",
  "version": "1.0.0",
  "description": "Neon Slither — online multiplayer arena game, mobile-first",
  "main": "server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.js",
    "postinstall": "node -e \"const fs=require('fs');const p='index.html';let s=fs.readFileSync(p,'utf8');if(!s.includes('/pc-mode.js')){s=s.replace('</body>','<script src=\\\"/pc-mode.js\\\"></script>\\n</body>');fs.writeFileSync(p,s)}\""
  },
  "dependencies": {"ws":"^8.18.0"}
}
